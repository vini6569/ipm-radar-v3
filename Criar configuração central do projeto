import os
import json
import urllib.request
import urllib.parse
import urllib.error


# ============================================================
# CONFIGURAÇÃO
# ============================================================

BASE_URL = "https://api.odds-api.io/v3"

BOOKMAKER = "Bet365"

MAX_EVENTOS_POR_CONSULTA = 10

TIMEOUT_REQUISICAO = 20


# ============================================================
# API KEY
# ============================================================

def obter_api_key():

    api_key = os.getenv("ODDS_API_KEY")

    if not api_key:

        raise RuntimeError(
            "ODDS_API_KEY não configurada no ambiente."
        )

    return api_key


# ============================================================
# REQUISIÇÃO
# ============================================================

def fazer_requisicao(url):

    requisicao = urllib.request.Request(
        url,
        headers={
            "User-Agent": "IPM-Radar/3.0",
            "Accept": "application/json"
        }
    )

    try:

        print()
        print("REQUISIÇÃO:")
        print(url)

        with urllib.request.urlopen(
            requisicao,
            timeout=TIMEOUT_REQUISICAO
        ) as resposta:

            codigo = resposta.getcode()

            conteudo = resposta.read().decode(
                "utf-8"
            )

        print(
            "HTTP:",
            codigo
        )

        print(
            "TAMANHO DA RESPOSTA:",
            len(conteudo)
        )

        if not conteudo:

            print(
                "⚠️ RESPOSTA VAZIA DA ODDS API."
            )

            return []

        try:

            dados = json.loads(
                conteudo
            )

        except json.JSONDecodeError:

            print()
            print("=" * 60)
            print("ERRO JSON ODDS API")
            print("=" * 60)

            print(
                "Resposta recebida:"
            )

            print(
                conteudo[:3000]
            )

            print("=" * 60)

            return []

        return dados

    except urllib.error.HTTPError as erro:

        detalhe = ""

        try:

            detalhe = erro.read().decode(
                "utf-8"
            )

        except Exception:

            pass

        print()
        print("=" * 60)
        print("ERRO HTTP ODDS API")
        print("=" * 60)

        print(
            "Código:",
            erro.code
        )

        print(
            "Mensagem:",
            erro.reason
        )

        print(
            "Detalhes:",
            detalhe
        )

        if erro.code == 401:

            print()
            print(
                "⚠️ ERRO 401:"
            )

            print(
                "A API KEY pode estar inválida."
            )

        elif erro.code == 403:

            print()
            print(
                "⚠️ ERRO 403:"
            )

            print(
                "Acesso não autorizado."
            )

        elif erro.code == 429:

            print()
            print(
                "⚠️ LIMITE 429 DA ODDS API."
            )

            print(
                "A consulta atual será encerrada."
            )

        print("=" * 60)

        return []

    except urllib.error.URLError as erro:

        print()
        print("=" * 60)
        print("ERRO DE CONEXÃO ODDS API")
        print("=" * 60)

        print(
            type(erro).__name__
        )

        print(
            erro
        )

        print("=" * 60)

        return []

    except Exception as erro:

        print()
        print("=" * 60)
        print("ERRO NA REQUISIÇÃO ODDS API")
        print("=" * 60)

        print(
            type(erro).__name__
        )

        print(
            erro
        )

        print("=" * 60)

        return []


